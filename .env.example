# ==============================================================
# BHUSETU BACKEND ENVIRONMENT VARIABLES
# ==============================================================

# Port for the Node.js server to run on (Render handles this automatically)
PORT=5000

# Google Gemini API Key for the AI Research Assistant
# Get it from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Future Database URL if migrating from SQLite to Postgres
# DATABASE_URL=postgresql://user:password@hostname:port/dbname

# URL of your deployed Vercel frontend (for CORS security)
FRONTEND_URL=https://your-vercel-app-url.vercel.app

